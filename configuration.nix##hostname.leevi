{ config, pkgs, ... }:
{
  imports = [
    ./common.nix
  ];

  networking.hostName = "leevi";

  boot.loader.systemd-boot = {
    enable = true;
  };

  system.stateVersion = "23.05";

  nix.nixPath = [
    "nixpkgs=/etc/nixpkgs"
    "nixos-config=/etc/nixos/configuration.nix"
  ];

  users.predefinedUsers = {
    jluttine = [ "wheel" "adbusers" ];
  };

  hardware = {
    printers = {
      ensurePrinters = [
        {
          name = "HP_LaserJet_1010";
          location = "Home";
          deviceUri = "http://192.168.10.10:631/printers/HP_LaserJet_1010";
          model = "drv:///sample.drv/generic.ppd";
          ppdOptions = {
            PageSize = "A4";
          };
        }
      ];
      ensureDefaultPrinter = "HP_LaserJet_1010";
    };
  };

  services = {

    # Let's try TLP instead of power-profiles-daemon. (I suppose
    # power-profiles-daemon is enabled by default by Noctalia?)
    # tlp = {
    #   enable = true;
    #   # I suppose Noctalia Power Profile uses this?
    #   pd.enable = true;
    #   #settings = { ... };
    # };
    # power-profiles-daemon.enable = false;

    # Needed for trash:// to work in pcmanfm file manager
    # https://unix.stackexchange.com/questions/8790/where-is-the-trash-directory-for-pcmanfm-and-xfe
    gvfs.enable = true;

    displayManager = {
      noctalia-greeter = {
        enable = true;
        settings = {
          keyboard = {
            layout = "fi";
          };
          idle.timeout = 300;
        };
      };
    };
    #displayManager.sddm.enable = true;
    #programs.sway = {
    #  enable = true;
    #  xwayland.enable = false;
    #};
    #xserver = {
    #  desktopManager.nide = {
    #    enable = true;
    #    installPackages = false;
    #  };
    #};

    syncthing = {
      enable = true;
      user = "jluttine";
      group = "users";
      dataDir = "/home/jluttine/.syncthing";
      configDir = "/home/jluttine/.syncthing/.config";
    };

    autorandr.enable = true;

    udev.packages = [ pkgs.tuxedo-touchpad-switch ];

  };

  # Touchpad on/off toggle
  services.actkbd = {
    enable = true;
    bindings = let
      light = "${pkgs.brightnessctl}/bin/brightnessctl";
      step = "5";
    in [
      {
        keys = [ 29 85 125 ];
        events = [ "key" ];
        command = "${pkgs.tuxedo-touchpad-switch}/bin/tuxedo-touchpad-toggle";
      }
      # Keybindings for adjusting monitor brightness. Adjusting brightness with
      # actkbd+brightnessctl is nice because it's independent of X and works in
      # ttys.
      {
        keys = [ 224 ];
        events = [ "key" ];
        # Use minimum brightness 0.1 so the display won't go totally black.
        command = "${light} --min-value=1 set ${step}%-";
      }
      {
        keys = [ 225 ];
        events = [ "key" ];
        command = "${light} set +${step}%";
      }
    ];
  };

  # Set fonts
  fonts.packages = with pkgs; [
    noto-fonts
    nerd-fonts.jetbrains-mono
    nerd-fonts.symbols-only
  ];
  fonts.fontconfig.defaultFonts = {
    monospace = [ "JetBrainsMono NF" ];
    sansSerif = [ "Noto Sans" ];
    serif = [ "Noto Serif" ];
  };

  # Enable users to modify brightness. NOTE: User must belong to video group!
  # (These modify udev rules, so if you just enabled this, probably best to
  # reboot.)
  hardware.acpilight.enable = true;

  programs = {
    #hyprland = {
    #  enable = true;
    #  withUWSM = true;
    #  xwayland.enable = false;
    #};
    noctalia = {
      enable = true;
      systemd.enable = true;
      recommendedServices.enable = true;
    };
    umbriel = {
      enable = true;
    };
    kdeconnect.enable = true;
    cryptos.enable = true;
    direnv.enable = true;

  systemd.user.services.umbriel = {
    environment = {
      XDG_CONFIG_HOME = "%h/.config";
      XDG_DATA_HOME = "%h/.local/share";
      XDG_CACHE_HOME = "%h/.cache";
    };
  };

  environment.systemPackages = with pkgs; [

    swayimg
    alacritty
    # Unfortunately, there aren't really other alternatives for adding
    # secret service support to NetworkManager..
    networkmanagerapplet

    # adb etc
    android-tools

    tuxedo-touchpad-switch

    # LaTeX
    texliveFull

    # OpenStreetMap editor
    josm

    # 3D modelling
    blender

    # Zotero client
    #qnotero

    #encfs

    # Diff tools
    kdiff3

    # Command line
    zsh
    p7zip
    qrencode

    # RSS reader
    # rssguard
    #feedreader
    rssguard

    w_scan2

    # Audio editor
    audacity

    # Screen recorder
    simplescreenrecorder

    # Panorama stitcher (with raw support)
    hugin
    #dcraw # marked as insecure

    inkscape

    #kdenlive
    ffmpeg-full
    # mlt
    # frei0r

    # HDR photography
    #luminanceHDR

    # Instant messaging
    telegram-desktop
    #linphone
    element-desktop
    karere

    # Encryption
    openssl

    # Tool for searching files/binaries from Nix packages
    nix-index

    # Programming
    emacs-pgtk
    gitflow
    hub
    ripgrep
    fd
    haskell-language-server
    haskellPackages.hoogle
    cabal-install
    shellcheck
    gh
    opencode
    opencode-desktop
    opencode-claude-auth

    # Password manager
    pass
    pass-secret-service
    yubikey-manager
    yubikey-personalization

    # C64
    vice
    jstest-gtk

    # Separate tiling window manager
    #i3

    patchelf

    # Mobile SSH replacement
    mosh

    # k3b

    dvdplusrwtools

    nixpkgs-review
    nixpkgs-fmt
    nixfmt
    gdb

    # Break timer
    stretchly

    (python3.withPackages (ps: with ps; [
      numpy
      scipy
      pandas
      ipython
      matplotlib
      ipympl
      # Python language server for Emacs
      python-lsp-server
    ]))

    # File manager
    pcmanfm

    # Printing and scanning
    simple-scan

    # Document readers
    #krop

    # Browsers
    firefox
    chromium

    # Email
    thunderbird

    # Gimp requires this, see: https://github.com/NixOS/nixpkgs/issues/60918
    #gnome3.gnome-themes-extra

    # Media player
    vlc

    #jitsi-meet-electron
    pear-desktop
    signal-desktop

    # For GNOME Keyring to work for git https protocol, use git-credential-libsecret:
    #
    #   git config --global credential-helper /run/current-system/sw/bin/git-credential-libsecret
    #
    # That binary is included in gitFull.
    gitFull
    git-extras

    # Choose some icon theme
    adwaita-icon-theme
    #maia-icon-theme
    # Not sure if this is needed:
    hicolor-icon-theme
  ];

}
